.tabbar{position:fixed;right:24rpx;bottom:24rpx;left:24rpx;z-index:15;display:grid;grid-template-columns:1fr 1.7fr 1fr 1fr;align-items:center;padding:12rpx;border:2rpx solid #e1eae5;border-radius:36rpx;background:rgba(255,255,255,.96);box-shadow:0 20rpx 52rpx rgba(24,60,53,.14)}.tab{display:grid;justify-items:center;gap:2rpx;min-height:76rpx;margin:0;padding:6rpx;border:0;background:transparent;color:#7b8782;font-size:22rpx;line-height:1.2}.tab:after{display:none}.icon{font-size:34rpx}.tab.active{color:#158b55}.tab.record{grid-template-columns:auto auto;align-items:center;justify-content:center;min-height:82rpx;border-radius:999rpx;background:linear-gradient(135deg,#39ca78,#28b96c);color:#fff;font-size:28rpx;font-weight:700}.tab.record .icon{font-size:30rpx}
