<view class="page">
  <view class="eyebrow">安全登录</view>
  <view class="title">欢迎使用 FormTally</view>
  <view class="intro">使用微信身份一键登录，首次登录后完成基本资料设置。</view>

  <view wx:if="{{busy}}" class="status">正在连接…</view>
  <block wx:if="{{!busy}}">
    <view class="agreement">
      <checkbox-group bindchange="onAgreementChange">
        <label class="agreement-check"><checkbox value="accepted" checked="{{acceptedAgreements}}" /><text>我已阅读并同意</text></label>
      </checkbox-group>
      <view class="agreement-links"><navigator class="agreement-link" url="/pages/legal/index?kind=terms">《用户协议》</navigator><text>与</text><text class="agreement-link" bindtap="openPrivacyContract">《隐私政策》</text><text>（版本 {{agreementVersion}}）</text></view>
    </view>
    <button class="primary" bindtap="startWeChatSession" loading="{{busy}}" disabled="{{busy}}">微信一键登录</button>
    <view class="hint">仅使用当前小程序内的微信身份创建账户，不会获取你的手机号。</view>
  </block>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
</view>
