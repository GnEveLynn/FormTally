<view class="page"><view class="title">删除账户与个人数据</view><view class="warning"><view class="heading">此操作不可恢复</view><view wx:if="{{hasPhone}}">必须使用当前已绑定的完整手机号获取验证码。</view><view wx:else>删除前将重新验证当前微信身份。</view></view><block wx:if="{{hasPhone}}"><input class="field" type="number" value="{{phone}}" data-field="phone" bindinput="field" placeholder="当前绑定的完整手机号"/><button disabled="{{busy}}" bindtap="send">发送删号验证码</button><input class="field" type="number" maxlength="6" value="{{code}}" data-field="code" bindinput="field" placeholder="6 位验证码"/></block><input class="field" value="{{confirmation}}" data-field="confirmation" bindinput="field" placeholder="输入 DELETE"/><view wx:if="{{error}}" class="error">{{error}}</view><button class="danger" disabled="{{busy}}" bindtap="remove">永久删除账户</button></view>
