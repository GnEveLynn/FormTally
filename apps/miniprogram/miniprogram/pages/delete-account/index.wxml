<view class="page"><view class="title">删除账户与个人数据</view><view class="warning"><view class="heading">此操作不可恢复</view><view wx:if="{{hasPhone}}">必须使用当前已绑定的完整手机号获取验证码。</view><view wx:else>删除前将重新验证当前微信身份。</view></view><block wx:if="{{hasPhone}}"><label class="field"><text>手机号：</text><input class="field-value" type="number" value="{{phone}}" data-field="phone" bindinput="field"/></label><button disabled="{{busy}}" bindtap="send">发送删号验证码</button><label class="field"><text>验证码：</text><input class="field-value" type="number" maxlength="6" value="{{code}}" data-field="code" bindinput="field"/></label></block><label class="field"><text>确认文字：</text><input class="field-value" value="{{confirmation}}" data-field="confirmation" bindinput="field" placeholder="输入 DELETE"/></label><view wx:if="{{error}}" class="error">{{error}}</view><button class="danger" disabled="{{busy}}" bindtap="remove">永久删除账户</button></view>
