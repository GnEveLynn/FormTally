.page{padding:32rpx;display:grid;gap:22rpx}.title{font-size:48rpx;font-weight:700}.warning{padding:24rpx;color:#7d2020;background:#fff0f0;border-radius:20rpx}.heading{font-weight:700}.field{box-sizing:border-box;height:88rpx;padding:0 22rpx;border:1rpx solid #cbd5d1;border-radius:16rpx;background:#fff;display:flex;align-items:center;gap:8rpx}.field-value{flex:1;min-width:0}.danger{color:#fff;background:#a22b2b}.error{color:#a22b2b}
