<view class="page">
  <view class="page-head"><view class="title">我的</view><view class="subtitle">管理资料、目标与账户</view></view>
  <view class="profile-card" bindtap="profile"><view class="avatar">餐</view><view class="profile-copy"><view class="profile-name">餐见用户</view><view>{{phone}}</view></view><text class="chevron">›</text></view>
  <view class="goal-card" bindtap="goals"><view class="goal-head"><view class="goal-icon">◎</view><view><view class="card-title">每日目标</view><view class="card-note">保持适合自己的饮食节奏</view></view><text class="chevron">›</text></view><view class="goal-value">{{goalSummary}}</view></view>
  <view class="card"><view class="card-title">健康设置</view><view class="tool-grid"><view class="tool" bindtap="profile"><text class="tool-icon green">♙</text><view><text>身体资料</text><text>{{profileSummary}}</text></view><text class="chevron">›</text></view><view class="tool" bindtap="goals"><text class="tool-icon orange">◎</text><view><text>每日目标</text><text>{{goalSummary}}</text></view><text class="chevron">›</text></view></view></view>
  <view class="card"><view class="card-title">账户与服务</view><view class="service" bindtap="remove"><text class="service-icon">▤</text><text>数据管理</text><text class="chevron">›</text></view><view class="service"><text class="service-icon">▧</text><text>用户协议</text><text class="service-note">2026-09-10</text></view><view class="service"><text class="service-icon">◇</text><text>隐私政策</text><text class="service-note">2026-09-10</text></view><view class="service"><text class="service-icon">▣</text><text>AI 图片处理说明</text><text class="service-note">2026-09-10</text></view></view>
  <button class="logout" bindtap="logout">退出登录</button>
</view>
