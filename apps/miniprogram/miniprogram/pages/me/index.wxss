.page{min-height:100vh;padding:34rpx 28rpx 170rpx;background:radial-gradient(circle at 35% 0,#eafbf5 0,transparent 650rpx),#f7faf8}.page-head{padding:4rpx 8rpx 26rpx}.title{font-size:52rpx;font-weight:800}.subtitle{margin-top:4rpx;color:#71807a;font-size:25rpx}.profile-card,.goal-card,.card{margin-bottom:18rpx;border:2rpx solid #e2ebe6;border-radius:30rpx;background:#fff;box-shadow:0 12rpx 34rpx rgba(23,60,53,.05)}.profile-card{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:22rpx;padding:28rpx}.avatar{display:grid;place-items:center;width:104rpx;height:104rpx;border-radius:50%;background:linear-gradient(135deg,#35c979,#179b5c);color:#fff;font-size:46rpx;font-weight:800}.profile-copy{display:grid;gap:8rpx;color:#71807a;font-size:23rpx}.profile-name{color:#173c35;font-size:33rpx;font-weight:800}.chevron{color:#87938e;font-size:36rpx}.goal-card{padding:28rpx;background:linear-gradient(135deg,#effcf5,#dff8e9)}.goal-head{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:16rpx}.goal-icon{display:grid;place-items:center;width:56rpx;height:56rpx;border-radius:50%;background:#fff;color:#20ae66;font-size:36rpx;font-weight:800}.card-title{font-size:32rpx;font-weight:800}.card-note{margin-top:4rpx;color:#71807a;font-size:22rpx}.goal-value{margin:28rpx 0 2rpx;color:#173c35;font-size:34rpx;font-weight:800}.card{padding:26rpx}.tool-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:22rpx}.tool{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:12rpx;min-width:0;padding:20rpx 16rpx;border:2rpx solid #e8eeeb;border-radius:20rpx}.tool>view{display:grid;min-width:0;gap:5rpx;font-size:25rpx;font-weight:700}.tool>view text:last-child{overflow:hidden;color:#7b8883;font-size:18rpx;font-weight:400;text-overflow:ellipsis;white-space:nowrap}.tool-icon{font-size:36rpx}.green{color:#25ae68}.orange{color:#f29c38}.service{display:grid;grid-template-columns:44rpx 1fr auto;align-items:center;gap:10rpx;min-height:88rpx;border-bottom:2rpx solid #edf1ef;font-size:26rpx}.service:last-child{border-bottom:0}.service-icon{color:#60716b;font-size:30rpx}.service-note{color:#8a9691;font-size:20rpx}.logout{margin-top:6rpx;border:2rpx solid #e4ebe7;border-radius:999rpx;background:#fff;color:#71807a;font-size:26rpx}.logout:after{display:none}
