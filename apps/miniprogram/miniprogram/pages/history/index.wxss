.page{min-height:100vh;padding:34rpx 28rpx 170rpx;background:radial-gradient(circle at 35% 0,#eafbf5 0,transparent 650rpx),#f7faf8}.page-head{padding:4rpx 8rpx 26rpx}.title{font-size:52rpx;font-weight:800}.subtitle,.section-subtitle{margin-top:4rpx;color:#71807a;font-size:25rpx}.calendar-card,.section-card,.state{margin-bottom:18rpx;border:2rpx solid #e2ebe6;border-radius:30rpx;background:#fff;box-shadow:0 12rpx 34rpx rgba(23,60,53,.05)}.calendar-card{padding:22rpx 20rpx 24rpx}.calendar-head{display:grid;grid-template-columns:64rpx 1fr 64rpx auto;align-items:center;gap:4rpx;font-size:32rpx;font-weight:800;text-align:center}.calendar-head button{min-width:0;margin:0;padding:0;border:0;background:transparent;color:#51615b;font-size:46rpx;line-height:64rpx}.calendar-head button:after,.calendar-day:after{display:none}.calendar-head .today-button{padding:0 18rpx;border:2rpx solid #e3ebe7;border-radius:999rpx;font-size:23rpx;font-weight:500;line-height:58rpx}.weekdays,.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr)}.weekdays{margin:18rpx 0 8rpx;color:#89948f;font-size:23rpx;text-align:center}.calendar-day{position:relative;display:grid;place-items:center;min-width:0;height:70rpx;margin:0;padding:0;border:0;background:transparent;color:#35443f;font-size:26rpx;line-height:1}.calendar-day.outside{color:#c7cfcb}.calendar-day.selected{border-radius:50%;background:#35bf76;color:#fff;font-weight:800;box-shadow:0 8rpx 20rpx rgba(53,191,118,.25)}.dot{position:absolute;bottom:8rpx;width:8rpx;height:8rpx;border-radius:50%;background:#31ba72}.calendar-day.selected .dot{background:#fff}.section-card{padding:26rpx}.section-head{display:flex;align-items:flex-start;justify-content:space-between}.section-title{font-size:34rpx;font-weight:800}.status-pill{padding:8rpx 18rpx;border-radius:999rpx;background:#e4f8ed;color:#20965c;font-size:22rpx;font-weight:700}.summary-content{display:grid;grid-template-columns:220rpx 1fr;align-items:center;gap:26rpx;margin-top:24rpx}.ring{position:relative;display:grid;place-items:center;width:210rpx;height:210rpx;border-radius:50%;background:conic-gradient(#35bf76 var(--progress),#e5f5ec 0)}.ring:before{position:absolute;inset:23rpx;border-radius:50%;background:#fff;content:""}.ring-inner{z-index:1;display:grid;justify-items:center;color:#71807a;font-size:20rpx}.ring-value{color:#173c35;font-size:42rpx;font-weight:800}.metrics{display:grid;gap:15rpx}.metrics>view{display:grid;grid-template-columns:1fr auto;gap:7rpx;color:#50605a;font-size:22rpx}.metrics progress{grid-column:1/-1}.groups{margin-top:12rpx}.group+.group{border-top:2rpx solid #edf1ef}.group-head{display:flex;align-items:center;gap:10rpx;padding:22rpx 4rpx 8rpx;font-weight:800}.meal-icon{font-size:30rpx}.breakfast{color:#f7aa00}.lunch{color:#218dd8}.dinner{color:#347ddb}.snack{color:#ff6855}.meal{position:relative;padding:14rpx 40rpx 18rpx 44rpx}.meal>view:first-child{display:flex;justify-content:space-between}.meal-time,.meal-detail{color:#7c8984;font-size:22rpx}.meal-energy{font-weight:700}.meal-detail{margin-top:7rpx}.chevron{position:absolute;right:4rpx;top:22rpx;color:#8b9691;font-size:36rpx}.empty-copy{padding:28rpx 4rpx 10rpx;color:#7b8883;line-height:1.6}.state{display:grid;gap:16rpx;padding:28rpx}.state-title{font-size:32rpx;font-weight:700}.error{color:#a22b2b}.retry{border:2rpx solid #dce5e0;border-radius:999rpx;background:#fff;color:#40524b}
