<view class="page"><view class="eyebrow">FORMTALLY</view><view class="title">历史</view>
<view class="pickers"><picker mode="date" fields="month" value="{{month}}" bindchange="changeMonth"><view class="picker">月份 {{month}} ›</view></picker><picker mode="date" value="{{selectedDate}}" bindchange="selectDate"><view class="picker">日期 {{selectedDate}} ›</view></picker></view>
<view wx:if="{{recordedDates.length}}" class="marks">有记录：<text wx:for="{{recordedDates}}" wx:key="*this">{{item}} </text></view>
<view wx:if="{{monthStatus === 'loading' || dayStatus === 'loading'}}" class="state">正在加载记录…</view>
<view wx:elif="{{dayStatus === 'error'}}" class="state"><view class="error">{{error}}</view><button bindtap="retry">重试</button></view>
<block wx:elif="{{day}}"><view wx:if="{{day.progress}}" class="summary">热量 {{day.progress.energy.consumed}} / {{day.progress.energy.target}} 千卡 · 蛋白质 {{day.progress.protein.consumed}}g</view><view wx:if="{{dayStatus === 'empty'}}" class="state">这天没有记录</view><view wx:else wx:for="{{groups}}" wx:key="mealType" class="group"><view class="heading">{{item.label}}</view><view wx:for="{{item.meals}}" wx:for-item="meal" wx:key="id" class="meal" data-id="{{meal.id}}" bindtap="openMeal"><text>{{meal.totals.energyKcal}} 千卡</text><text>蛋白质 {{meal.totals.proteinGrams}}g · 碳水 {{meal.totals.carbGrams}}g · 脂肪 {{meal.totals.fatGrams}}g</text></view></view></block></view>
