<view class="page"><view wx:if="{{status === 'loading'}}">正在加载餐食…</view><view wx:elif="{{status === 'error'}}" class="error">{{error}}</view><block wx:elif="{{meal}}"><view class="head"><view><view>{{meal.localDate}} · {{mealTypeLabel}}</view><view class="title">{{meal.totals.energyKcal}} 千卡</view></view><button size="mini" bindtap="edit">编辑</button></view><image wx:if="{{meal.image}}" src="{{meal.image.url}}" mode="aspectFill"/><view class="notice">估算值：{{meal.estimateNotice}}</view><view wx:for="{{meal.items}}" wx:key="name" class="item"><view class="heading">{{item.name}}</view><view>{{item.grams}} 克 · {{item.nutrition.energyKcal}} 千卡</view><view>蛋白质 {{item.nutrition.proteinGrams}}g · 碳水 {{item.nutrition.carbGrams}}g · 脂肪 {{item.nutrition.fatGrams}}g</view></view><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{meal.image}}" disabled="{{busy}}" bindtap="removeImage">仅移除图片</button><button class="danger" disabled="{{busy}}" bindtap="removeMeal">删除整餐</button></block></view>
