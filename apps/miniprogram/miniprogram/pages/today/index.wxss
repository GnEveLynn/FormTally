.page {
    min-height: 100vh;
    padding: 34rpx 28rpx 170rpx;
    background: radial-gradient(circle at 35% 0, #eafbf5 0, transparent 650rpx), #f7faf8
}

.brand-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 4rpx 8rpx 28rpx
}

.title {
    font-size: 58rpx;
    font-weight: 800
}

.subtitle,
.muted {
    color: #71807a
}

.calendar {
    font-size: 44rpx
}

.date-tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6rpx;
    padding: 8rpx;
    border: 2rpx solid #e4ece8;
    border-radius: 28rpx;
    background: #fff
}

.date-tab {
    display: grid;
    gap: 4rpx;
    min-height: 104rpx;
    margin: 0;
    padding: 14rpx;
    border: 0;
    border-radius: 22rpx;
    background: transparent;
    color: #71807b;
    font-size: 26rpx;
    line-height: 1.3
}

.date-tab text:first-child {
    font-size: 30rpx;
    font-weight: 700
}

.date-tab.active {
    background: #e2f8ec;
    color: #199b5c
}

.summary-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 20rpx;
    margin-top: 20rpx;
    padding: 28rpx;
    border: 2rpx solid #e2ebe6;
    border-radius: 32rpx;
    background: #fff
}

.ring {
    width: 260rpx;
    height: 260rpx;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: conic-gradient(#35bf76 var(--progress), #dff5e8 0);
    position: relative
}

.ring:before {
    content: "";
    position: absolute;
    inset: 28rpx;
    border-radius: 50%;
    background: #fff
}

.ring-inner {
    z-index: 1;
    display: grid;
    justify-items: center;
    color: #728079;
    font-size: 24rpx
}

.ring-value {
    color: #173c35;
    font-size: 46rpx;
    font-weight: 800
}

.remaining {
    display: grid;
    gap: 8rpx;
    color: #6d7975
}

.remaining-value {
    color: #173c35;
    font-size: 52rpx;
    font-weight: 800
}

.remaining-value text {
    font-size: 26rpx
}

.remaining .muted {
    font-size: 24rpx;
    line-height: 1.5
}

.nutrients {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12rpx;
    margin-top: 16rpx
}

.metric {
    display: grid;
    gap: 12rpx;
    padding: 20rpx 16rpx;
    border: 2rpx solid #e4ebe8;
    border-radius: 24rpx;
    background: #fff;
    font-size: 25rpx
}

.metric>view {
    display: flex;
    gap: 8rpx;
    font-weight: 700
}

.metric-value {
    font-size: 29rpx;
    font-weight: 800
}

.metric-value text {
    color: #7c8884;
    font-size: 22rpx;
    font-weight: 400
}

.metric-icon.protein {
    color: #ff6b57
}

.metric-icon.carb {
    color: #f1a21d
}

.metric-icon.fat {
    color: #2c8ee8
}

.meal-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14rpx;
    margin-top: 18rpx
}

.meal-card {
    min-height: 210rpx;
    padding: 24rpx;
    border: 2rpx solid #e3ebe7;
    border-radius: 28rpx;
    background: #fff
}

.meal-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 12rpx;
    font-weight: 700
}

.meal-head text:last-child {
    color: #89938f
}

.meal-icon {
    font-size: 36rpx
}

.breakfast {
    color: #f7aa00
}

.lunch {
    color: #218dd8
}

.dinner {
    color: #347ddb
}

.snack {
    color: #ff6855
}

.empty-copy {
    display: grid;
    gap: 4rpx;
    margin-top: 28rpx;
    color: #84908b;
    font-size: 24rpx;
    line-height: 1.45
}

.meal-row {
    display: flex;
    justify-content: space-between;
    gap: 8rpx;
    margin-top: 20rpx;
    font-size: 23rpx
}

.record-button {
    position: fixed;
    left: 50%;
    bottom: 30rpx;
    z-index: 5;
    transform: translateX(-50%);
    width: 330rpx;
    min-height: 96rpx;
    border: 0;
    border-radius: 999rpx;
    background: linear-gradient(135deg, #39ca78, #28b96c);
    box-shadow: 0 16rpx 40rpx rgba(40, 185, 108, .28);
    color: #fff;
    font-size: 30rpx;
    font-weight: 700
}

.state {
    display: grid;
    gap: 20rpx;
    margin-top: 28rpx;
    padding: 28rpx;
    border-radius: 28rpx;
    background: #fff
}

.state-title {
    font-size: 34rpx;
    font-weight: 700
}

.error {
    color: #a22b2b
}

.secondary,
.primary {
    min-height: 88rpx;
    border-radius: 999rpx;
    font-weight: 700
}

.secondary {
    border: 2rpx solid #dce5e0;
    background: #fff;
    color: #40524b
}

.primary {
    border: 0;
    background: #38c676;
    color: #fff
}

.modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: flex;
    align-items: flex-end;
    background: rgba(16, 40, 32, .62)
}

.record-dialog {
    width: 100%;
    max-height: 92vh;
    overflow: auto;
    padding: 12rpx 30rpx 180rpx;
    border-radius: 40rpx 40rpx 0 0;
    background: #fff
}

.handle {
    width: 78rpx;
    height: 8rpx;
    margin: 0 auto 16rpx;
    border-radius: 99rpx;
    background: #d3dad7
}

.dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 40rpx;
    font-weight: 800
}

.dialog-head button {
    width: 70rpx;
    height: 70rpx;
    margin: 0;
    border: 0;
    border-radius: 50%;
    background: #f2f5f3;
    color: #708079;
    font-size: 42rpx;
    line-height: 66rpx
}

.meal-type {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 28rpx;
    margin: 20rpx 0;
    padding: 8rpx 24rpx;
    border-radius: 22rpx;
    background: #effaf4;
    font-weight: 700
}

.meal-type picker {
    text-align: right;
    line-height: 76rpx
}

.photo-box {
    padding: 24rpx;
    border: 2rpx dashed #cbd9d2;
    border-radius: 26rpx;
    text-align: center
}

.photo-box image {
    width: 100%;
    height: 260rpx;
    border-radius: 20rpx
}

.photo-box>view:first-child {
    display: grid;
    gap: 14rpx;
    padding: 24rpx;
    color: #708079
}

.camera-icon {
    font-size: 54rpx
}

.photo-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16rpx;
    margin-top: 16rpx
}

.photo-actions button {
    min-height: 76rpx;
    border: 0;
    border-radius: 20rpx;
    background: #eff8f3;
    color: #176344;
    font-size: 27rpx
}

.field {
    display: grid;
    gap: 12rpx;
    margin-top: 24rpx;
    font-weight: 700
}

.field textarea {
    width: 100%;
    min-height: 124rpx;
    padding: 20rpx;
    border: 2rpx solid #d5dfda;
    border-radius: 22rpx;
    font-weight: 400
}

.hint {
    margin: 14rpx 0;
    color: #75837d;
    font-size: 24rpx
}

.dialog-actions {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 16rpx;
    margin-top: 22rpx
}
