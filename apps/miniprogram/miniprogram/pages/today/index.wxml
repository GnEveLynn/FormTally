<view class="page">
  <view class="brand-row"><view><view class="title">FormTally</view><view class="subtitle">饮食记录</view></view><view class="calendar">▣</view></view>
  <view class="date-tabs"><button wx:for="{{dateTabs}}" wx:key="date" data-date="{{item.date}}" class="date-tab {{localDate === item.date ? 'active' : ''}}" bindtap="selectDate"><text>{{item.label}}</text><text>{{item.displayDate}}</text></button></view>
  <view wx:if="{{status === 'loading'}}" class="state">正在加载记录…</view>
  <view wx:elif="{{status === 'error'}}" class="state"><view class="state-title">暂时无法加载</view><view class="error" role="alert">{{error}}</view><button class="secondary" bindtap="retry">重试</button></view>
  <block wx:elif="{{day || status === 'guest'}}">
    <view wx:if="{{status === 'guest'}}" class="state"><view class="state-title">先看看今天的饮食记录</view><view>登录后即可记录饮食、查看营养估算和历史数据。</view><button class="secondary" bindtap="recordMeal">登录后开始记录</button></view>
    <view wx:if="{{day.progress}}" class="summary-card"><view class="ring" style="--progress: {{day.progress.energy.percent * 3.6}}deg"><view class="ring-inner"><text class="ring-value">{{day.progress.energy.consumed}}</text><text>/ {{day.progress.energy.target}}</text><text>千卡</text></view></view><view class="remaining"><text>还可摄入</text><text class="remaining-value">{{day.progress.energy.remaining}} <text>千卡</text></text><text class="muted">保持均衡饮食，遇见更好的自己。</text></view></view>
    <view wx:if="{{day.progress}}" class="nutrients"><view class="metric"><view><text class="metric-icon protein">◉</text><text>蛋白质</text></view><text class="metric-value">{{day.progress.protein.consumed}} <text>/ {{day.progress.protein.target}}g</text></text><progress percent="{{day.progress.protein.percent}}" stroke-width="6" activeColor="#48c783" backgroundColor="#edf1ef"/></view><view class="metric"><view><text class="metric-icon carb">♨</text><text>碳水</text></view><text class="metric-value">{{day.progress.carb.consumed}} <text>/ {{day.progress.carb.target}}g</text></text><progress percent="{{day.progress.carb.percent}}" stroke-width="6" activeColor="#8fd86b" backgroundColor="#edf1ef"/></view><view class="metric"><view><text class="metric-icon fat">◯</text><text>脂肪</text></view><text class="metric-value">{{day.progress.fat.consumed}} <text>/ {{day.progress.fat.target}}g</text></text><progress percent="{{day.progress.fat.percent}}" stroke-width="6" activeColor="#f5ac35" backgroundColor="#edf1ef"/></view></view>
    <view class="meal-grid"><view wx:for="{{groups}}" wx:key="mealType" class="meal-card" data-type="{{item.mealType}}" bindtap="openRecord"><view class="meal-head"><text class="meal-icon {{item.mealType}}">{{item.mealType === 'breakfast' ? '☀' : item.mealType === 'lunch' ? '♨' : item.mealType === 'dinner' ? '☾' : '♡'}}</text><text>{{item.label}}</text><text>›</text></view><view wx:if="{{item.meals.length}}"><view wx:for="{{item.meals}}" wx:for-item="meal" wx:key="id" class="meal-row"><text>{{meal.time}}</text><text>{{meal.totals.energyKcal}} 千卡</text></view></view><view wx:else class="empty-copy">还没有记录<text>快去记录吧～</text></view></view></view>
  </block>
  <view wx:if="{{recordOpen}}" class="modal-backdrop" bindtap="closeRecord"><view class="record-dialog" catchtap="stopPropagation"><view class="handle"></view><view class="dialog-head"><text>记录饮食</text><button bindtap="closeRecord" aria-label="关闭">×</button></view><view class="meal-type"><text>餐别</text><picker range="{{mealLabels}}" value="{{mealTypeIndex}}" bindchange="onMealTypeChange"><view>{{mealLabels[mealTypeIndex]}}　›</view></picker></view><view class="photo-box"><image wx:if="{{imagePath}}" src="{{imagePath}}" mode="aspectFill"/><view wx:else><text class="camera-icon">▣</text><text>拍照或选择食物照片</text></view><view class="photo-actions"><button bindtap="chooseCamera" loading="{{busy}}">拍照</button><button bindtap="chooseAlbum">相册</button></view></view><view class="field"><text>补充描述（选填）</text><textarea value="{{description}}" maxlength="500" placeholder="例如：鸡胸肉、米饭和西兰花，少油、酱汁另放" bindinput="onDescriptionInput"/></view><view class="hint">AI 会结合照片，自行判断食物、份量、做法和备注。</view><view wx:if="{{error}}" class="error" role="alert">{{error}}</view><view class="dialog-actions"><button class="secondary" bindtap="startManual">手动记录</button><button class="primary" bindtap="startAI">确认并生成估算</button></view></view></view>
</view>
