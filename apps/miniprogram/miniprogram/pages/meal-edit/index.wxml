<view class="page"><view class="title">编辑餐食</view><view class="notice">所有营养数据均为估算值，请按实际情况核对。</view><block wx:if="{{meal}}"><picker mode="date" value="{{occurredDate}}" bindchange="occurred"><view class="field">日期：{{occurredDate}}</view></picker><picker mode="time" value="{{occurredTime}}" bindchange="occurredTime"><view class="field">时间：{{occurredTime}}</view></picker><picker range="{{mealTypeLabels}}" bindchange="type"><view class="field">餐别：{{mealType}}</view></picker><view wx:for="{{items}}" wx:key="index" class="item"><input value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="input" placeholder="食物名称"/><input type="digit" value="{{item.grams}}" data-index="{{index}}" bindinput="grams" placeholder="克数"/><input type="digit" value="{{item.nutrition.energyKcal}}" data-index="{{index}}" data-field="energyKcal" bindinput="input" placeholder="千卡"/><input type="digit" value="{{item.nutrition.proteinGrams}}" data-index="{{index}}" data-field="proteinGrams" bindinput="input" placeholder="蛋白质 g"/><input type="digit" value="{{item.nutrition.carbGrams}}" data-index="{{index}}" data-field="carbGrams" bindinput="input" placeholder="碳水 g"/><input type="digit" value="{{item.nutrition.fatGrams}}" data-index="{{index}}" data-field="fatGrams" bindinput="input" placeholder="脂肪 g"/><button size="mini" data-index="{{index}}" bindtap="removeItem">删除此项</button></view><button bindtap="addItem">添加食物</button><view wx:if="{{error}}" class="error">{{error}}</view><button type="primary" disabled="{{busy}}" bindtap="save">{{busy ? '保存中…' : '保存修改'}}</button></block><view wx:else>{{error || '正在加载…'}}</view></view>
