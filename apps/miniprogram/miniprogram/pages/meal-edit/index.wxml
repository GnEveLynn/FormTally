<view class="page"><view class="title">编辑餐食</view><view class="notice">所有营养数据均为估算值，请按实际情况核对。</view><block wx:if="{{meal}}"><picker mode="date" value="{{occurredDate}}" bindchange="occurred"><view class="field">日期：{{occurredDate}}</view></picker><picker mode="time" value="{{occurredTime}}" bindchange="occurredTime"><view class="field">时间：{{occurredTime}}</view></picker><picker range="{{mealTypeLabels}}" value="{{mealTypeIndex}}" bindchange="type"><view class="field">餐别：{{mealTypeLabels[mealTypeIndex]}}</view></picker><view wx:for="{{items}}" wx:key="index" class="item"><label class="editable-field"><text>食物名称：</text><input class="editable-value" value="{{item.name}}" data-index="{{index}}" data-field="name" bindinput="input"/></label><label class="editable-field"><text>重量：</text><input class="editable-value" type="digit" value="{{item.grams}}" data-index="{{index}}" bindinput="grams"/><text>克</text></label><label class="editable-field"><text>热量：</text><input class="editable-value" type="digit" value="{{item.nutrition.energyKcal}}" data-index="{{index}}" data-field="energyKcal" bindinput="input"/><text>千卡</text></label><label class="editable-field"><text>蛋白质：</text><input class="editable-value" type="digit" value="{{item.nutrition.proteinGrams}}" data-index="{{index}}" data-field="proteinGrams" bindinput="input"/><text>克</text></label><label class="editable-field"><text>碳水：</text><input class="editable-value" type="digit" value="{{item.nutrition.carbGrams}}" data-index="{{index}}" data-field="carbGrams" bindinput="input"/><text>克</text></label><label class="editable-field"><text>脂肪：</text><input class="editable-value" type="digit" value="{{item.nutrition.fatGrams}}" data-index="{{index}}" data-field="fatGrams" bindinput="input"/><text>克</text></label><button size="mini" data-index="{{index}}" bindtap="removeItem">删除此项</button></view><button bindtap="addItem">添加食物</button><view wx:if="{{error}}" class="error">{{error}}</view><button type="primary" disabled="{{busy}}" bindtap="save">{{busy ? '保存中…' : '保存修改'}}</button></block><view wx:else>{{error || '正在加载…'}}</view></view>
