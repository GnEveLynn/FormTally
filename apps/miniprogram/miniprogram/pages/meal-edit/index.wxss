.page{padding:32rpx;display:grid;gap:24rpx}.title{font-size:48rpx;font-weight:700}.notice{padding:20rpx;background:#fff2d8;border-radius:16rpx}.field,.item{padding:24rpx;border:1rpx solid #dbe5e1;border-radius:20rpx;background:#fff}.item{display:grid;gap:12rpx}.editable-field{display:flex;align-items:center;gap:8rpx}.editable-value{flex:1;min-width:0;min-height:80rpx;border-bottom:1rpx solid #e5ebe8}.error{color:#a22b2b}
