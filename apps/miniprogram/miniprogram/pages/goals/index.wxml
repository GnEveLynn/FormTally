<view class="page"><view class="title">每日目标</view><view class="notice">修改从下一个本地日期生效，今天与历史记录不变。</view><picker range="{{modeLabels}}" bindchange="mode"><view class="field">目标模式：{{mode}}</view></picker><block wx:if="{{mode === 'automatic'}}"><picker range="{{objectiveLabels}}" bindchange="objective"><view class="field">当前目标：{{objective}}</view></picker><picker wx:if="{{objective !== 'maintain'}}" range="{{paceLabels}}" bindchange="pace"><view class="field">速度：{{pace}}</view></picker></block><block wx:else><input class="field" type="digit" value="{{manual.energyKcal}}" data-field="energyKcal" bindinput="manual" placeholder="热量 kcal"/><input class="field" type="digit" value="{{manual.proteinGrams}}" data-field="proteinGrams" bindinput="manual" placeholder="蛋白质 g"/><input class="field" type="digit" value="{{manual.carbGrams}}" data-field="carbGrams" bindinput="manual" placeholder="碳水 g"/><input class="field" type="digit" value="{{manual.fatGrams}}" data-field="fatGrams" bindinput="manual" placeholder="脂肪 g"/></block><button disabled="{{busy}}" bindtap="preview">预览修改</button><view wx:if="{{preview}}" class="result"><view>{{preview.effectiveFrom}} 生效</view><view>{{preview.target.energyKcal}} 千卡 · 蛋白质 {{preview.target.proteinGrams}}g · 碳水 {{preview.target.carbGrams}}g · 脂肪 {{preview.target.fatGrams}}g</view><button type="primary" disabled="{{busy}}" bindtap="save">确认保存</button></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="success">{{message}}</view></view>
