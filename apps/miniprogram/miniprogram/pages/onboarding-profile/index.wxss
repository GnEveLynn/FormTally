.page { padding: 40rpx 48rpx 64rpx; }
.step, .intro { color: var(--ft-color-text-muted); }
.title { margin-top: 16rpx; font-size: var(--ft-font-size-title); font-weight: 700; }
.intro { margin: 16rpx 0 32rpx; }
.field { display: grid; gap: 12rpx; margin-top: 24rpx; font-weight: 700; }
.control { min-height: 96rpx; padding: 0 24rpx; border: 2rpx solid #cbd5d1; border-radius: 24rpx; background: #fff; line-height: 96rpx; font-weight: 400; }
.health { display: grid; gap: 20rpx; margin-top: 32rpx; }
.health label { display: flex; align-items: center; min-height: 88rpx; gap: 12rpx; }
.primary { min-height: 104rpx; margin-top: 40rpx; border-radius: 999rpx; background: var(--ft-color-text); color: #fff; font-weight: 700; }
.error { margin-top: 8rpx; color: #a22b2b; font-weight: 400; }
