<view class="page"><view class="title">身体资料与时区</view><view class="notice">修改资料不会改写今天和历史目标。</view><block wx:if="{{form}}"><picker range="{{sexLabels}}" value="{{sexIndex}}" bindchange="sex"><view class="field">生理性别：{{sexLabels[sexIndex]}}</view></picker><picker mode="date" value="{{form.birthDate}}" data-field="birthDate" bindchange="field"><view class="field">出生日期：{{form.birthDate}}</view></picker><label class="field"><text>身高：</text><input class="field-value" type="digit" value="{{form.heightCm}}" data-field="heightCm" bindinput="field"/><text>厘米</text></label><label class="field"><text>体重：</text><input class="field-value" type="digit" value="{{form.weightKg}}" data-field="weightKg" bindinput="field"/><text>千克</text></label><picker range="{{activityLabels}}" value="{{activityIndex}}" bindchange="activity"><view class="field">活动水平：{{activityLabels[activityIndex]}}</view></picker><view class="field">时区：{{timezoneLabel}}</view><checkbox-group class="health-options" bindchange="health"><label><checkbox value="pregnant" checked="{{form.healthContext.pregnant}}"/>孕期</label><label><checkbox value="breastfeeding" checked="{{form.healthContext.breastfeeding}}"/>哺乳期</label><label><checkbox value="clinicalDietRequired" checked="{{form.healthContext.clinicalDietRequired}}"/>需要疾病膳食管理</label></checkbox-group><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="success">{{message}}</view><button type="primary" disabled="{{busy}}" bindtap="save">保存资料</button></block><view wx:else>{{error || '正在加载…'}}</view></view>
