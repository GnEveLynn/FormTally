<view class="page"><view class="title">身体资料与时区</view><view class="notice">修改资料不会改写今天和历史目标。</view><block wx:if="{{form}}"><picker range="{{sexLabels}}" bindchange="sex"><view class="field">生理性别：{{form.biologicalSex}}</view></picker><picker mode="date" value="{{form.birthDate}}" data-field="birthDate" bindchange="field"><view class="field">出生日期：{{form.birthDate}}</view></picker><input class="field" type="digit" value="{{form.heightCm}}" data-field="heightCm" bindinput="field" placeholder="身高 cm"/><input class="field" type="digit" value="{{form.weightKg}}" data-field="weightKg" bindinput="field" placeholder="体重 kg"/><picker range="{{activityLabels}}" bindchange="activity"><view class="field">活动水平：{{form.activityLevel}}</view></picker><input class="field" value="{{form.timezone}}" data-field="timezone" bindinput="field" placeholder="时区"/><checkbox-group bindchange="health"><label><checkbox value="pregnant" checked="{{form.healthContext.pregnant}}"/>孕期</label><label><checkbox value="breastfeeding" checked="{{form.healthContext.breastfeeding}}"/>哺乳期</label><label><checkbox value="clinicalDietRequired" checked="{{form.healthContext.clinicalDietRequired}}"/>需要疾病膳食管理</label></checkbox-group><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{message}}" class="success">{{message}}</view><button type="primary" disabled="{{busy}}" bindtap="save">保存资料</button></block><view wx:else>{{error || '正在加载…'}}</view></view>
