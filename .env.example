# Optional API listen address. The API uses this local default when unset.
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgres://formtally:formtally@127.0.0.1:5432/formtally?sslmode=disable
TEST_DATABASE_URL=postgres://formtally:formtally@127.0.0.1:5432/formtally?sslmode=disable
ALLOWED_ORIGINS=http://127.0.0.1:5173
APP_ENV=development
SMS_DRIVER=test
STORAGE_DRIVER=filesystem
STORAGE_PATH=./var/images
IMAGE_URL_SECRET=change-this-outside-development
